@startuml
'https://plantuml.com/class-diagram
!pragma layout smetana

class CupcakeTop{
-String flavor
-double price
}

class CupcakeBottom{
-String flavor
-double price
}

class Orderline{
- CupcakeBottom cupcakeBottom
- CupcakeTop cupcakeTop
- int quantity

+ double getIndividualPrice()
+ double getTotalPrice()
}

class HistoricOrderline extends Orderline{
- double cupcakeBottomPrice
- double cupcakeTopPrice

+ double getTotalPrice()
}


class Order {
 - int id
 - Customer customer
 - List<Orderline> orderlines
 - OrderStatus status
 - LocalDate orderDate

 + void addOrderline(orderline)
 + double getTotal()
 + double getSize()
}

Enum OrderStatus{
CART
PLACED
APPROVED
COMPLETED
DENIED
}

class OrderService{
-OrderMapper orderMapper

+ void saveOrder(order)
+ void saveOrderlines(orderId, order)
+ List<Order> getOrderHistory()
+ List<Order> getPlacedOrders()
+ List<Order> getApprovedOrders()
+ void updateOrderStatus(id, status)
+ void completeOrder(order)
}

class OrderController{
- ConnectionPool connectionPool
- OrderService orderService

+ void setRoutes(config)
- void renderMenu(ctx)
- void addToCart(ctx)
- void renderCart(ctx)
- void placeOrder(ctx)
- void checkCartAttribute(ctx)
- void getCurrentUser(ctx)
- void renderOrderHistory(ctx)
- void renderAdminFrontPage(ctx)
- void updateOrderStatus(ctx)
- void redirectCustomer(ctx)
- void redirectAdmin(ctx)
}

class OrderMapper {
-ConnectionPool connectionPool
- Logger logger

+ int saveOrder(order)
+ void saveOrderline(orderline, orderId)
+ List<CupcakeBottom> allCakeBottoms()
+ List<CupcakeTop> allCakeTops()
+ List<Order> getOrderHistory()
+ void updateOrderStatus(id, status)
+ List<Order> getPlacedOrders()
+ List<Order> getApprovedOrders()
- List<Order> getOrdersByStatus(status)
+ int saveToOrderHistory(order)
+ void saveToOrderlineHistory(orderline, orderId)
+ void removeOrder(order)
}

abstract class User{
-int id
-String email
-String name
-String password
-double balance
}

class Customer extends User{
}

class Admin extends User{
}

class UserController{
- ConnectionPool connectionPool
- UserService userService

+ void setRoutes(config)
- void renderFrontpage(ctx)
- void renderLoginForm(ctx)
- void renderRegisterForm(ctx)
- void login(ctx)
- void register(ctx)
- void logout(ctx)
- void redirectAdmin(ctx)
}

class UserService{
- ConnectionPool connectionPool
- UserMapper userMapper

+ boolean checkIsEmailAvailable(email)
+ User createUser(name, email, password)
+ User login(email, password)
+ boolean isUserAdmin(user)
+ boolean checkIsPasswordValid(password)
}

class UserMapper{
-ConnectionPool connectionPool

+ boolean checkEmailIsAvailable(email)
+ User getUserByEmail(email)
+ User createUser(user)
}

class StringCapitalizer {
+ String capitalizeFirstOnly(string)
}


Order *-- Orderline
Orderline *-- CupcakeBottom
Orderline *-- CupcakeTop
Customer "1"-- "0..*"Order
OrderService --> OrderMapper
OrderController --> OrderService
UserService --> UserMapper
UserController --> UserService


@enduml